# Artéfacts de compilation.
target/
experiments/*/target/

# Poids de modèles : 1,1 Go, et ils se récupèrent.
# CLAP  : scripts/preparer-modele.sh   HTDemucs : scripts/preparer-demucs.sh
# Les essais régénèrent les leurs (voir le README de chacun).
models/
experiments/*/modeles/

# Bases locales : celle du dépôt est un reste de développement, celle qui
# compte vit dans le dossier de données de l'application.
*.db
*.db-shm
*.db-wal
*.db.avant-*

# Sorties de l'éditeur et de l'analyse, écrites à côté de la base.
stems/
greffes/

# Rendus de diagnostic (aperçus de placement, etc.) — régénérés par les
# exemples, jamais versionnés.
expe/

# Captures d'écran de travail déposées à la racine.
/Capture d’écran*.png
/Capture d'écran*.png

.DS_Store

# État local de Claude Code. Pour versionner des réglages d'équipe :
# `git add -f .claude/settings.json`.
.claude/

# Régénéré par Tauri à chaque build.
apps/desktop/gen/

# Sorties des sondages : jetables, régénérées depuis une base locale. Elles
# porteraient le contenu d'une bibliothèque réelle (titres, identifiants
# d'artistes) — jamais versionnées.
experiments/clap-texte/reference.json
experiments/musicbrainz-genres/genres.json
experiments/musicbrainz-genres/aspiration.log
experiments/popularite/cache.json
experiments/popularite/echantillon.json
