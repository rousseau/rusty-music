{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty Valise",
  "version": "0.1.0",
  "identifier": "fm.rustymusic.compagnon",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rusty Valise",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "shortDescription": "Écouter une valise d'albums préparée par Rusty Music.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
