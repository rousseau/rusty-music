<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La lecture continue écran verrouillé et application en arrière-plan. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Le dossier Documents de l'app apparaît dans le Finder (iPhone branché) :
	     c'est là qu'on dépose une valise. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- iOS 27 arrête au lancement une app qui n'adopte pas le cycle de vie
	     par scènes (UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption).
	     `tao` ne branche son délégué de scène que si ce manifeste annonce
	     plusieurs scènes ; sur iPhone, une seule fenêtre s'ouvre de toute façon. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
</dict>
</plist>
