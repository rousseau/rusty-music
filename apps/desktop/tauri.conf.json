{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty Music",
  "version": "0.1.0",
  "identifier": "fm.rustymusic.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rusty Music",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Écouter, explorer et éditer sa bibliothèque musicale, hors ligne.",
    "longDescription": "Suite musicale locale et autonome : lecture, carte 2D de la bibliothèque par similarité sonore, et démixage en stems. Tout le calcul se fait sur la machine, aucun service distant.",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../models/clap-audio-encoder-b5.bpk": "models/clap-audio-encoder-b5.bpk",
      "../../models/htdemucs.safetensors": "models/htdemucs.safetensors"
    }
  }
}
