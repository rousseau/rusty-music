{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusty Music",
  "version": "0.1.0",
  "identifier": "fm.rustymusic.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Écouter, explorer et éditer sa bibliothèque musicale, hors ligne.",
    "longDescription": "Suite musicale locale et autonome : lecture, carte 2D de la bibliothèque par similarité sonore, et démixage en stems. Tout le calcul se fait sur la machine, aucun service distant.",
    "homepage": "https://github.com/rousseau/rusty-music",
    "license": "GPL-3.0-or-later",
    "copyright": "GPL-3.0-or-later — plan de ville © les contributeurs OpenStreetMap (ODbL)",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../models/adtof_frame_rnn.onnx": "models/adtof_frame_rnn.onnx",
      "../../models/basic_pitch_nmp.onnx": "models/basic_pitch_nmp.onnx",
      "../../models/beat_this_mel.onnx": "models/beat_this_mel.onnx",
      "../../models/beat_this_small.onnx": "models/beat_this_small.onnx",
      "../../models/allinone-harmonix-fold0.safetensors": "models/allinone-harmonix-fold0.safetensors",
      "../../models/allinone-harmonix-fold1.safetensors": "models/allinone-harmonix-fold1.safetensors",
      "../../models/allinone-harmonix-fold2.safetensors": "models/allinone-harmonix-fold2.safetensors",
      "../../models/allinone-harmonix-fold3.safetensors": "models/allinone-harmonix-fold3.safetensors",
      "../../models/allinone-harmonix-fold4.safetensors": "models/allinone-harmonix-fold4.safetensors",
      "../../models/allinone-harmonix-fold5.safetensors": "models/allinone-harmonix-fold5.safetensors",
      "../../models/allinone-harmonix-fold6.safetensors": "models/allinone-harmonix-fold6.safetensors",
      "../../models/allinone-harmonix-fold7.safetensors": "models/allinone-harmonix-fold7.safetensors",
      "../../ville-paris.db": "ville-paris.db"
    }
  }
}
